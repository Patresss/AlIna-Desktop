<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<fx:root alignment="CENTER" spacing="7" styleClass="header-bar-button-box" type="HBox"
         xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER" styleClass="header-action-group">
            <children>
                <Button accessibleText="%header.tooltip.newSession" mnemonicParsing="false"
                        onAction="#createAndOpenNewChatThread">
                    <graphic><FontIcon iconLiteral="mdoal-create_new_folder" /></graphic>
                    <tooltip><Tooltip text="%header.tooltip.newSession" /></tooltip>
                    <styleClass>
                        <String fx:value="button-circle" />
                        <String fx:value="flat" />
                    </styleClass>
                </Button>
                <Button accessibleText="%header.tooltip.history" mnemonicParsing="false"
                        onAction="#openThreadHistories">
                    <graphic><FontIcon iconLiteral="mdal-history" /></graphic>
                    <tooltip><Tooltip text="%header.tooltip.history" /></tooltip>
                    <styleClass>
                        <String fx:value="button-circle" />
                        <String fx:value="flat" />
                    </styleClass>
                </Button>
            </children>
        </HBox>

        <HBox alignment="CENTER" styleClass="header-action-group">
            <children>
                <Button accessibleText="%header.tooltip.about" mnemonicParsing="false" onAction="#openAbout">
                    <graphic><FontIcon iconLiteral="mdoal-info" /></graphic>
                    <tooltip><Tooltip text="%header.tooltip.about" /></tooltip>
                    <styleClass>
                        <String fx:value="button-circle" />
                        <String fx:value="flat" />
                    </styleClass>
                </Button>
                <Button fx:id="agentSessionButton" accessibleText="%header.tooltip.agentSession" disable="true"
                        mnemonicParsing="false" onAction="#openAgentSession">
                    <graphic><FontIcon iconLiteral="mdoal-launch" /></graphic>
                    <tooltip><Tooltip text="%header.tooltip.agentSession" /></tooltip>
                    <styleClass>
                        <String fx:value="button-circle" />
                        <String fx:value="flat" />
                    </styleClass>
                </Button>
                <MenuButton accessibleText="%header.tooltip.settings" mnemonicParsing="false">
                    <items>
                        <MenuItem fx:id="uiSettingsMenuItem" onAction="#openUiSettings" text="%settings.ui.title" />
                        <MenuItem fx:id="dashboardSettingsMenuItem" onAction="#openDashboardSettings" text="%settings.dashboard.title" />
                        <MenuItem fx:id="openCodeSettingsMenuItem" onAction="#openOpenCodeSettings" text="%settings.opencode.title" />
                        <MenuItem fx:id="commandsMenuItem" onAction="#openCommands" text="%command.title" />
                        <MenuItem fx:id="quickActionSettingsMenuItem" onAction="#openQuickActionSettings" text="%quickaction.settings.title" />
                        <MenuItem fx:id="schedulerMenuItem" onAction="#openSchedulerSettings" text="%scheduler.title" />
                    </items>
                    <graphic><FontIcon iconLiteral="mdmz-settings" /></graphic>
                    <tooltip><Tooltip text="%header.tooltip.settings" /></tooltip>
                    <styleClass>
                        <String fx:value="no-arrow" />
                        <String fx:value="flat" />
                        <String fx:value="button-circle" />
                        <String fx:value="header-settings-action" />
                    </styleClass>
                </MenuButton>
            </children>
        </HBox>

        <HBox alignment="CENTER" styleClass="header-action-group">
            <children>
                <ToggleButton fx:id="splitModeToggleButton" accessibleText="%header.tooltip.splitMode"
                              mnemonicParsing="false">
                    <graphic><FontIcon iconLiteral="mdmz-vertical_split" /></graphic>
                    <tooltip><Tooltip text="%header.tooltip.splitMode" /></tooltip>
                    <styleClass>
                        <String fx:value="button-circle" />
                        <String fx:value="flat" />
                    </styleClass>
                </ToggleButton>
                <ToggleButton fx:id="pinToggleButton" accessibleText="%header.tooltip.pin" mnemonicParsing="false">
                    <graphic><FontIcon iconLiteral="mdrmz-pin" /></graphic>
                    <tooltip><Tooltip text="%header.tooltip.pin" /></tooltip>
                    <styleClass>
                        <String fx:value="button-circle" />
                        <String fx:value="flat" />
                    </styleClass>
                </ToggleButton>
            </children>
        </HBox>
    </children>
</fx:root>
