<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<fx:root prefHeight="10000.0" styleClass="chat-window" type="BorderPane"
         xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <StackPane fx:id="chatAnswersPane" prefHeight="150.0" prefWidth="200.0"
                   styleClass="chat-conversation-surface" />
    </center>
    <bottom>
        <StackPane maxWidth="1.7976931348623157E308" styleClass="chat-footer-dock">
            <children>
                <VBox fx:id="footerPane" maxWidth="1.7976931348623157E308" styleClass="chat-footer">
                    <children>
                        <FlowPane fx:id="imageAttachmentPane" hgap="8.0" managed="false" vgap="8.0"
                                  visible="false" styleClass="image-attachment-pane" />
                        <StackPane fx:id="composerPane" maxWidth="1.7976931348623157E308" styleClass="chat-composer">
                            <children>
                                <HBox alignment="CENTER" maxWidth="1.7976931348623157E308">
                                    <children>
                                        <TextArea fx:id="chatTextArea" maxWidth="1.7976931348623157E308"
                                                  onKeyPressed="#chatTextAreaOnKeyPressed" prefWidth="10000.0"
                                                  styleClass="chat-composer-input" wrapText="true" />
                                        <VBox fx:id="inputButtonsBox" styleClass="chat-composer-actions">
                                            <children>
                                                <Button fx:id="sendButton" accessibleText="%chat.button.send" alignment="CENTER"
                                                        mnemonicParsing="false" onAction="#sendMessageFromUi">
                                                    <graphic><FontIcon iconLiteral="fth-send" /></graphic>
                                                    <styleClass>
                                                        <String fx:value="button-circle" />
                                                        <String fx:value="chat-primary-action" />
                                                    </styleClass>
                                                </Button>
                                                <Button fx:id="attachImageButton" accessibleText="%chat.button.attachImage"
                                                        mnemonicParsing="false" onAction="#chooseImageAttachments">
                                                    <graphic><FontIcon iconLiteral="fth-paperclip" /></graphic>
                                                    <styleClass>
                                                        <String fx:value="button-circle" />
                                                        <String fx:value="flat" />
                                                        <String fx:value="chat-attachment-action" />
                                                    </styleClass>
                                                </Button>
                                                <Button fx:id="streamControlButton" alignment="CENTER" mnemonicParsing="false"
                                                        onAction="#streamControlFromUi">
                                                    <styleClass>
                                                        <String fx:value="button-circle" />
                                                        <String fx:value="flat" />
                                                        <String fx:value="chat-secondary-action" />
                                                    </styleClass>
                                                </Button>
                                                <Button fx:id="clearChatButton" accessibleText="%chat.button.clearChat"
                                                        alignment="CENTER" mnemonicParsing="false" onAction="#clearChatFromUi">
                                                    <graphic><FontIcon iconLiteral="mdal-cleaning_services" /></graphic>
                                                    <styleClass>
                                                        <String fx:value="button-circle" />
                                                        <String fx:value="flat" />
                                                        <String fx:value="chat-clear-action" />
                                                    </styleClass>
                                                </Button>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </StackPane>
                        <HBox fx:id="statusBar" alignment="CENTER_LEFT" spacing="8.0" styleClass="chat-composer-status">
                            <children>
                                <Label fx:id="commandLabel" maxWidth="1.7976931348623157E308"
                                       styleClass="chat-command-status" HBox.hgrow="ALWAYS" />
                                <Label fx:id="modelLabel" alignment="CENTER_RIGHT" styleClass="model-selector-label" />
                                <Label fx:id="effortLabel" alignment="CENTER_RIGHT" styleClass="model-selector-label" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </bottom>
</fx:root>
